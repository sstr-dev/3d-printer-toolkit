# Copy to .env in the project directory. Use trusted POSIX shell assignments.
# K1C: pre-2025; K1_2025: 2025 series; generic: local development.
# unknown prompts for selection. K1 currently uses fallback local paths.
PRINTER_MODEL=K1C

# Numbered menus are the default. Set 1 for arrow keys or j/k navigation.
# main.sh --interactive enables interactive navigation for one run.
MENU_INTERACTIVE=0
# Both modes use a header, bordered options, and footer.
# Width inside the border: 20-200; total line width is MENU_WIDTH + 2.
MENU_WIDTH=64
MENU_OUTER_CHAR='='
MENU_INNER_CHAR='-'
# Uncomment to disable named text colors (selection highlighting remains).
# NO_COLOR=1

# Self update defaults (also used when settings are missing or empty).
UPDATE_BRANCH=main
UPDATE_REMOTE=origin
# 1 enables startup checks; 0 disables them and hides Self Update.
UPDATE_CHECK_ON_START=1
# HTTP low-speed threshold in bytes/second and duration in seconds.
# These settings are not a total fetch timeout.
UPDATE_LOW_SPEED_LIMIT=1
UPDATE_LOW_SPEED_TIME=15

# Optional path overrides. Leave commented to use model-specific defaults.
# These paths show K1C defaults; quote paths containing spaces.
# USR_DATA=/usr/data
# USR_SHARE=/usr/share
# INITD_FOLDER=/etc/init.d
# BIN_FOLDER=/usr/bin
# PRINTER_DATA_FOLDER=/usr/data/printer_data
# PRINTER_DATA_CONFIG_FOLDER=/usr/data/printer_data/config
# PRINTER_DATA_LOG_FOLDER=/usr/data/printer_data/logs

# Optional Info display settings; these do not set application paths.
# DATA_ROOT=/usr/data
# CONFIG_DIR=/usr/data/printer_data/config
